{
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2022",
		"lib": [ "es2022" ],

		"strict": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,

		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,

		"esModuleInterop": true,

		"noEmit": true,

		"types": [ "node", "vitest/globals" ]
	},
	"include": [
		"src",
		"test"
	]
}
